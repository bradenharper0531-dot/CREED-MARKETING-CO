# Supabase → Project Settings → API. Use the SAME project as the Creed platform
# so logins, roles and the recruiting pipeline are shared.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Interview booking page applicants land on after applying
# (Calendly, Cal.com, Google Calendar booking page…). Leave blank to skip.
VITE_BOOKING_URL=
